# Copy this file to .env and fill in your values
# GitHub Personal Access Token (optional but recommended — raises rate limit from 60 to 5000 req/hr)
# Create one at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# Output directory for generated videos (relative to backend/)
OUTPUT_DIR=outputs

# Frontend URL for CORS (change if your frontend runs on a different port)
FRONTEND_URL=http://localhost:3000
